# Supabase Configuration (Get these from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-to-browser

# Optional Client / Other Member Keys
# FIRMS_MAP_KEY=your-nasa-firms-map-key
# GEMINI_API_KEY=your-gemini-api-key

# Offline / Mocks Toggle (Set to false once Supabase is connected & seeded)
NEXT_PUBLIC_USE_MOCKS=true
